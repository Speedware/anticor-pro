# Токен бота от @BotFather
BOT_TOKEN=

# ID чата/группы, куда бот будет присылать заявки и где доступны /status и кнопка «Закрыть»
# Узнать можно, например, через @getidsbot
ADMIN_CHAT_ID=

# Порт HTTP-сервера, принимающего заявки с сайта
PORT=3000

# Домены, с которых разрешены запросы к API (через запятую)
ALLOWED_ORIGINS=https://anticor.pro,https://www.anticor.pro

# Путь к файлу базы данных SQLite
DB_PATH=./data/requests.sqlite

# Срок хранения заявок в годах — по истечении автоматически удаляются (см. privacy.html)
RETENTION_YEARS=5
